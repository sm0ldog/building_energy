!-Generator IDFEditor 1.5
!-Option SortedOrder

!-NOTE: All comments with '!-' are ignored by the IDFEditor and are generated automatically.
!-      Use '!' comments if they need to be retained when using the IDFEditor.


!-   ===========  ALL OBJECTS IN CLASS: VERSION ===========

Version,
    9.1;                     !- Version Identifier


!-   ===========  ALL OBJECTS IN CLASS: SIMULATIONCONTROL ===========

SimulationControl,
    No,                      !- Do Zone Sizing Calculation
    No,                      !- Do System Sizing Calculation
    No,                      !- Do Plant Sizing Calculation
    No,                      !- Run Simulation for Sizing Periods
    Yes;                     !- Run Simulation for Weather File Run Periods


!-   ===========  ALL OBJECTS IN CLASS: BUILDING ===========

Building,
    One Precinct,            !- Name
    0,                       !- North Axis {deg}
    City,                    !- Terrain
    0.04,                    !- Loads Convergence Tolerance Value
    0.4,                     !- Temperature Convergence Tolerance Value {deltaC}
    FullInteriorAndExterior, !- Solar Distribution
    25,                      !- Maximum Number of Warmup Days
    6;                       !- Minimum Number of Warmup Days


!-   ===========  ALL OBJECTS IN CLASS: SHADOWCALCULATION ===========

ShadowCalculation,
    AverageOverDaysInFrequency,  !- Calculation Method
    30,                      !- Calculation Frequency
    15000;                   !- Maximum Figures in Shadow Overlap Calculations


!-   ===========  ALL OBJECTS IN CLASS: SURFACECONVECTIONALGORITHM:INSIDE ===========

SurfaceConvectionAlgorithm:Inside,
    TARP;                    !- Algorithm


!-   ===========  ALL OBJECTS IN CLASS: SURFACECONVECTIONALGORITHM:OUTSIDE ===========

SurfaceConvectionAlgorithm:Outside,
    DOE-2;                   !- Algorithm


!-   ===========  ALL OBJECTS IN CLASS: HEATBALANCEALGORITHM ===========

HeatBalanceAlgorithm,
    ConductionTransferFunction,  !- Algorithm
    200;                     !- Surface Temperature Upper Limit {C}


!-   ===========  ALL OBJECTS IN CLASS: ZONEAIRHEATBALANCEALGORITHM ===========

ZoneAirHeatBalanceAlgorithm,
    AnalyticalSolution;      !- Algorithm


!-   ===========  ALL OBJECTS IN CLASS: TIMESTEP ===========

Timestep,
    4;                       !- Number of Timesteps per Hour


!-   ===========  ALL OBJECTS IN CLASS: CONVERGENCELIMITS ===========

ConvergenceLimits,
    5,                       !- Minimum System Timestep {minutes}
    25;                      !- Maximum HVAC Iterations


!-   ===========  ALL OBJECTS IN CLASS: SITE:LOCATION ===========

Site:Location,
    SGP_Singapore.486980_IWEC,  !- Name
    1.37,                    !- Latitude {deg}
    103.98,                  !- Longitude {deg}
    8,                       !- Time Zone {hr}
    16;                      !- Elevation {m}


!-   ===========  ALL OBJECTS IN CLASS: RUNPERIOD ===========

RunPeriod,
    ,                        !- Name
    1,                       !- Begin Month
    1,                       !- Begin Day of Month
    ,                        !- Begin Year
    12,                      !- End Month
    31,                      !- End Day of Month
    ,                        !- End Year
    Saturday,                !- Day of Week for Start Day
    No,                      !- Use Weather File Holidays and Special Days
    No,                      !- Use Weather File Daylight Saving Period
    Yes,                     !- Apply Weekend Holiday Rule
    Yes,                     !- Use Weather File Rain Indicators
    Yes;                     !- Use Weather File Snow Indicators


!-   ===========  ALL OBJECTS IN CLASS: SCHEDULETYPELIMITS ===========

ScheduleTypeLimits,
    Any Number;              !- Name

ScheduleTypeLimits,
    Fraction,                !- Name
    0.0,                     !- Lower Limit Value
    1.0,                     !- Upper Limit Value
    CONTINUOUS;              !- Numeric Type


!-   ===========  ALL OBJECTS IN CLASS: SCHEDULE:COMPACT ===========

Schedule:Compact,
    Always On,               !- Name
    Fraction,                !- Schedule Type Limits Name
    Through: 12/31,          !- Field 1
    For: AllDays,            !- Field 2
    Until: 24:00,            !- Field 3
    1.0;                     !- Field 4

Schedule:Compact,
    Always Off,               !- Name
    Fraction,                !- Schedule Type Limits Name
    Through: 12/31,          !- Field 1
    For: AllDays,            !- Field 2
    Until: 24:00,            !- Field 3
    0.0;                     !- Field 4

Schedule:Compact,
    AirCon_normal,             !- Name
    Fraction,                !- Schedule Type Limits Name
    Through: 31 Dec,         !- Field 1
    For: AllDays,           !- Field 2
    Until: 07:00,            !- Field 3
    1,                       !- Field 4
    Until: 22:00,            !- Field 5
    0,                       !- Field 6
    Until: 24:00,            !- Field 7
    1;                       !- Field 8

Schedule:Compact,
    AirCon_24hr,             !- Name
    Fraction,                !- Schedule Type Limits Name
    Through: 31 Dec,         !- Field 1
    For: AllDays,           !- Field 2
    Until: 24:00,            !- Field 3
    1;                       !- Field 22

SCHEDULE:COMPACT,
    Living_Infiltration_AirCon,    !- Name
    Fraction,                 !- Schedule Type Limits Name
    Through: 12/31,           !- Field 1
    For: AllDays,             !- Field 2
    Until: 07:00,             !- Field 3
    0.2,                      !- Field 4
    Until: 22:00,             !- Field 5
    1,                        !- Field 6
    Until: 24:00,             !- Field 7
    0.2;                      !- Field 8


!-   ===========  ALL OBJECTS IN CLASS: MATERIAL ===========
MATERIAL,
    ConcreteWall,             !- Name
    MediumRough,              !- Roughness
    0.15,                     !- Thickness
    0.8,                      !- Conductivity
    2400,                     !- Density
    880,                      !- Specific Heat
    0.85,                     !- Thermal Absorptance
    0.79,                     !- Solar Absorptance
    0.79;                     !- Visible Absorptance

MATERIAL,
    WhitePaint,               !- Name
    MediumRough,              !- Roughness
    0.15,                     !- Thickness
    0.8,                      !- Conductivity
    2400,                     !- Density
    880,                      !- Specific Heat
    0.91,                     !- Thermal Absorptance
    0.365,                    !- Solar Absorptance
    0.365;                    !- Visible Absorptance

MATERIAL,
    CoolPaint,                !- Name
    MediumRough,              !- Roughness
    0.15,                     !- Thickness
    0.8,                      !- Conductivity
    2400,                     !- Density
    880,                      !- Specific Heat
    0.9,                      !- Thermal Absorptance
    0.12,                     !- Solar Absorptance
    0.12;                     !- Visible Absorptance

MATERIAL,
    EvaporativePaint,         !- Name
    MediumRough,              !- Roughness
    0.15,                     !- Thickness
    0.8,                      !- Conductivity
    2400,                     !- Density
    880,                      !- Specific Heat
    0.95,                     !- Thermal Absorptance
    0.09,                     !- Solar Absorptance
    0.09;                     !- Visible Absorptance

MATERIAL,
    Greenwall,                !- Name
    MediumRough,              !- Roughness
    0.079,                    !- Thickness
    2.5,                      !- Conductivity
    1293,                     !- Density
    853,                      !- Specific Heat
    0.98,                     !- Thermal Absorptance
    0.75,                     !- Solar Absorptance
    0.75;                     !- Visible Absorptance

!-   ===========  ALL OBJECTS IN CLASS: WINDOWMATERIAL:SIMPLEGLAZINGSYSTEM ===========

WindowMaterial:SimpleGlazingSystem,
    SingleGlazingEuroGrey,   !- Name
    5.93,                    !- U-Factor {W/m2-K}
    0.620,                   !- Solar Heat Gain Coefficient
    0.495;                   !- Visible Transmittance

WindowMaterial:SimpleGlazingSystem,
    SingleGlazingBCA,        !- Name
    5.82,                    !- U-Factor {W/m2-K}
    0.609,                   !- Solar Heat Gain Coefficient
    0.9;                     !- Visible Transmittance

WindowMaterial:SimpleGlazingSystem,
    DoubleGlazingBCA,        !- Name
    3.448,                   !- U-Factor {W/m2-K}
    0.435,                   !- Solar Heat Gain Coefficient
    0.8;                     !- Visible Transmittance

WindowMaterial:SimpleGlazingSystem,
    SingleGlazingThickBCA,   !- Name
    5.7,                     !- U-Factor {W/m2-K}
    0.5307,                  !- Solar Heat Gain Coefficient
    0.9;                     !- Visible Transmittance


!-   ===========  ALL OBJECTS IN CLASS: CONSTRUCTION ===========

Construction,
    Project Wall,            !- Name
    ConcreteWall;                !- Outside Layer

Construction,
    Project Floor,           !- Name
    ConcreteWall;                !- Outside Layer

Construction,
    Project Flat Roof,       !- Name
    ConcreteWall;                !- Outside Layer

Construction,
    Project Ceiling,         !- Name
    ConcreteWall;                !- Outside Layer

Construction,
    Project External Window, !- Name
    SingleGlazingEuroGrey;   !- Outside Layer


!-   ===========  ALL OBJECTS IN CLASS: GLOBALGEOMETRYRULES ===========

GlobalGeometryRules,
    UpperLeftCorner,         !- Starting Vertex Position
    CounterClockWise,        !- Vertex Entry Direction
    World;                   !- Coordinate System


!-   ===========  ALL OBJECTS IN CLASS: SIZING:PARAMETERS ===========

Sizing:Parameters,
    1.1,                     !- Heating Sizing Factor
    1.1,                     !- Cooling Sizing Factor
    4;                       !- Timesteps in Averaging Window


!-   ===========  ALL OBJECTS IN CLASS: OUTPUT:VARIABLEDICTIONARY ===========

Output:VariableDictionary,
    IDF,                     !- Key Field
    Name;                    !- Sort Option


!-   ===========  ALL OBJECTS IN CLASS: OUTPUT:SURFACES:DRAWING ===========

Output:Surfaces:Drawing,
    DXF;                     !- Report Type


!-   ===========  ALL OBJECTS IN CLASS: OUTPUTCONTROL:TABLE:STYLE ===========

OutputControl:Table:Style,
    HTML,                    !- Column Separator
    JtoKWH;                  !- Unit Conversion


!-   ===========  ALL OBJECTS IN CLASS: OUTPUT:VARIABLE ===========

Output:Variable,
    *,                       !- Key Value
    Zone Ideal Loads Supply Air Total Cooling Energy,  !- Variable Name
    Monthly;                  !- Reporting Frequency

Output:Variable,
    *,                       !- Key Value
    Zone Ideal Loads Supply Air Sensible Cooling Energy,  !- Variable Name
    Monthly;                  !- Reporting Frequency

Output:Variable,
    *,                       !- Key Value
    Zone Ideal Loads Supply Air Latent Cooling Energy,  !- Variable Name
    Monthly;                  !- Reporting Frequency